# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
# Admin API access (session revocation, user creation for seed script). Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HIBP API
HIBP_API_URL=https://api.pwnedpasswords.com

# Environment
ENV=development

# CORS origins (comma-separated)
CORS_ORIGINS=chrome-extension://*,http://localhost:3000

# AI backend: "ollama" (local) or "groq" (cloud)
AI_BACKEND=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_URL=http://localhost:11434
