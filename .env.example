# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
# Admin API access (session revocation, user creation for seed script). Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HIBP API
HIBP_API_URL=https://api.pwnedpasswords.com

# Environment
ENV=development

# CORS origins (comma-separated)
CORS_ORIGINS=chrome-extension://*,http://localhost:3000

# AI backend: "ollama" (local) or "openrouter" (cloud)
AI_BACKEND=ollama
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OLLAMA_URL=http://localhost:11434

# Optional: direct Postgres connection string (Supabase project settings -> Database ->
# Connection string -> URI). Only used by scripts/apply_vault_schema.py to run DDL without
# the SQL editor. Never required for the app itself (supabase-py talks PostgREST, not this).
SUPABASE_DB_URL=

# Vault (HU17): master key (KEK) for envelope encryption, base64-urlsafe, 32 raw bytes.
# Generate with: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Without this set, /api/v1/vault rejects every operation (AC5) — no plaintext is ever persisted.
# There is no recovery mechanism if this key is lost: every stored credential becomes
# permanently undecryptable (informe R13). Never commit it; store it outside the DB.
VAULT_MASTER_KEY=

# Second factor (HU18): key that seals each user's TOTP secret, base64-urlsafe, 32 raw bytes.
# DISTINCT from VAULT_MASTER_KEY on purpose: revoking a departed member must keep working with
# the vault KEK down, and it needs to verify the admin's TOTP to do so. Same generator:
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Without it every step-up fails closed (503) — the second factor is never bypassed.
# Losing it locks every user out of foreign secrets until a factor row is deleted and the
# person re-enrolls (R-HU18-1). Never commit it.
TOTP_MASTER_KEY=
